# ─────────────────────────────────────────────────────────────────────────────
# Credentials for the "helios" S3 object store.
#
# ⚠ DO NOT COMMIT REAL KEYS. This file is a template with placeholders.
#   Prefer creating the Secret imperatively so the keys never touch git:
#
#     kubectl -n make-lastz-chains create secret generic helios-s3 \
#       --from-literal=AWS_ACCESS_KEY_ID='...' \
#       --from-literal=AWS_SECRET_ACCESS_KEY='...'
#
# Only the driver pod mounts this Secret. Task pods receive the same credentials
# as environment variables because 03-configmap.yaml sets
# `fusion.exportStorageCredentials = true` — Nextflow forwards the driver's
# resolved credentials into each task pod it creates.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: helios-s3
  namespace: make-lastz-chains
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "REPLACE_ME_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "REPLACE_ME_SECRET_KEY"
